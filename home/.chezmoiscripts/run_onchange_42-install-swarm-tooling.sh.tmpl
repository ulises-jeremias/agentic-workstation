#!/usr/bin/env bash
# chezmoi:template:left-delimiter="{{" right-delimiter="}}"
{{- $swarm := index . "install_group_swarm" | default false -}}
{{- if $swarm }}
set -euo pipefail

if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  c_reset=$'\033[0m'
  c_blue=$'\033[1;34m'
  c_yellow=$'\033[1;33m'
  c_green=$'\033[1;32m'
else
  c_reset=''
  c_blue=''
  c_yellow=''
  c_green=''
fi

log() { printf '%b[swarm]%b %s\n' "$c_blue" "$c_reset" "$*"; }
warn() { printf '%b[swarm]%b %s\n' "$c_yellow" "$c_reset" "$*"; }
ok() { printf '%b[swarm]%b %s\n' "$c_green" "$c_reset" "$*"; }
has_cmd() { command -v "$1" >/dev/null 2>&1; }
can_sudo() { sudo -n true >/dev/null 2>&1; }

# CI skip unless mocked
if [[ "${CI:-}" == "true" && -z "${SWARM_FORCE_INSTALL:-}" ]]; then
  log "CI detected — skipping Herdr/tmux install (use SWARM_FORCE_INSTALL=1 to force)"
  exit 0
fi

# --- tmux ---
install_tmux() {
  if has_cmd tmux; then
    ok "tmux already installed: $(tmux -V 2>&1)"
    return 0
  fi
  log "Installing tmux"
  if has_cmd pacman; then
    if can_sudo; then sudo pacman -S --noconfirm --needed tmux; else warn "skip tmux (sudo unavailable)"; fi
  elif has_cmd apt-get; then
    if can_sudo; then sudo apt-get update -y && sudo apt-get install -y tmux; else warn "skip tmux (sudo unavailable)"; fi
  elif has_cmd dnf; then
    if can_sudo; then sudo dnf install -y tmux; else warn "skip tmux (sudo unavailable)"; fi
  elif has_cmd brew; then
    brew install tmux
  else
    warn "No supported package manager for tmux"
  fi
  if has_cmd tmux; then
    ok "tmux installed: $(tmux -V 2>&1)"
  else
    warn "tmux not available after install attempt"
  fi
}

# --- herdr ---
install_herdr() {
  if has_cmd herdr; then
    ok "herdr already installed: $(herdr --version 2>&1 | head -n1)"
    return 0
  fi
  log "Installing herdr"
  # Order: brew → mise → official installer
  if has_cmd brew; then
    if brew list herdr >/dev/null 2>&1; then
      ok "herdr via brew already"
      return 0
    fi
    if brew install herdr 2>/dev/null; then
      ok "herdr installed via brew: $(herdr --version 2>&1 | head -n1)"
      return 0
    fi
    warn "brew install herdr failed, trying fallback"
  fi
  if has_cmd mise; then
    if mise use -g herdr 2>/dev/null; then
      if has_cmd herdr; then
        ok "herdr installed via mise: $(herdr --version 2>&1 | head -n1)"
        return 0
      fi
    fi
  fi
  # Official installer
  if has_cmd curl; then
    if curl -fsSL https://herdr.dev/install.sh | sh 2>&1 | tee /tmp/herdr-install.log; then
      # Ensure ~/.local/bin in PATH
      if has_cmd herdr; then
        ok "herdr installed via official script: $(herdr --version 2>&1 | head -n1)"
        return 0
      else
        warn "herdr installer completed but binary not in PATH — check /tmp/herdr-install.log and ensure ~/.local/bin in PATH"
      fi
    else
      warn "herdr official installer failed — see /tmp/herdr-install.log"
    fi
  else
    warn "curl not available — cannot run herdr.dev/install.sh"
  fi
  warn "herdr not installed — swarm will use tmux fallback (see https://herdr.dev/docs/install/)"
}

# --- integrations ---
install_herdr_integration() {
  if ! has_cmd herdr; then
    warn "herdr not available — skipping integration install"
    return 0
  fi
  if ! has_cmd opencode; then
    log "opencode not available — skipping herdr integration for opencode"
    return 0
  fi
  # Ensure opencode config dir exists
  mkdir -p "${HOME}/.config/opencode" 2>/dev/null || true
  if herdr integration install opencode 2>&1 | tee /tmp/herdr-integration-opencode.log; then
    ok "herdr integration opencode installed"
  else
    warn "herdr integration install opencode failed — check /tmp/herdr-integration-opencode.log"
  fi
  # Check outdated
  if herdr integration list --json 2>/dev/null | grep -q outdated; then
    warn "herdr integration outdated — run: herdr integration install opencode"
  fi
}

log "Agent Toolkit Swarms — installing tmux + Herdr"
install_tmux
install_herdr
{{- $ints := index . "swarm_integrations" | default (list "opencode") -}}
{{- range $ints }}
{{- if eq . "opencode" }}
install_herdr_integration
{{- end }}
{{- end }}
ok "swarm tooling complete — verify with: agent-toolkit swarm doctor; dots-doctor"

{{- else }}
# Swarms disabled — no-op
set -euo pipefail
exit 0
{{- end }}
