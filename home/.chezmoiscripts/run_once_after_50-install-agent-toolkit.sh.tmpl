#!/usr/bin/env bash
# chezmoi:template:left-delimiter="{{" right-delimiter="}}"
set -euo pipefail

log() { printf '\033[1;34m[agent-toolkit]\033[0m %s\n' "$*"; }
ok() { printf '\033[1;32m[agent-toolkit]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[agent-toolkit]\033[0m %s\n' "$*"; }
has_cmd() { command -v "$1" >/dev/null 2>&1; }

# Skip in CI/hermetic environments (chezmoi apply during testing)
if [ "${CI:-}" = "true" ] || [ -n "${HERMETIC_PORT:-}" ] || [ -n "${GITHUB_ACTIONS:-}" ]; then
  log "CI environment detected — skipping agent-toolkit install"
  exit 0
fi

log "Installing agent-toolkit..."

# Prefer AUR on Arch Linux (avoids Python env management entirely)
if has_cmd pacman && { has_cmd yay || has_cmd paru; }; then
  if has_cmd yay; then
    yay -S --noconfirm --needed agent-toolkit-cli 2>/dev/null || true
  else
    paru -S --noconfirm --needed agent-toolkit-cli 2>/dev/null || true
  fi
# uv tool install (preferred Python method — no pip)
elif has_cmd uv; then
  uv tool install agent-toolkit-cli
else
  warn "No supported package manager found (pacman/yay/paru/uv)."
  warn "Install uv first: curl -LsSf https://astral.sh/uv/install.sh | sh"
  warn "Then re-run: chezmoi apply"
  exit 1
fi

# Deploy profiles to all detected AI tools
if has_cmd agent-toolkit; then
  log "Deploying profiles..."
  if agent-toolkit install --force; then
    ok "agent-toolkit installed and profiles deployed"
  else
    warn "agent-toolkit install failed — run 'agent-toolkit install' after restarting shell"
    exit 1
  fi
else
  warn "agent-toolkit not in PATH yet — restart your shell, then run: agent-toolkit install"
  warn "Or ensure ~/.local/bin is in PATH before running chezmoi apply again"
  exit 1
fi
