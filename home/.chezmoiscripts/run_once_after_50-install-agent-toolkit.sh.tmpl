#!/usr/bin/env bash
# chezmoi:template:left-delimiter="{{" right-delimiter="}}"
# Thin workstation — install canonical Agent Toolkit CLI (V binary), then
# `agent-toolkit install`. Channel preference: Homebrew → AUR → GitHub → uv
# V-launcher (>=1.11.0). Must not import agent_toolkit as the product.
set -euo pipefail

log() { printf '\033[1;34m[agent-toolkit]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[agent-toolkit]\033[0m %s\n' "$*"; }

# Skip in CI/hermetic environments (chezmoi apply during testing)
if [ "${CI:-}" = "true" ] || [ -n "${HERMETIC_PORT:-}" ] || [ -n "${GITHUB_ACTIONS:-}" ]; then
	log "CI environment detected — skipping agent-toolkit install"
	exit 0
fi

# Resolve lib — prefer deployed copy, fallback to chezmoi source for first-run
# ordering (run_once_after may execute before dot_local/lib is materialized).
_AT_LIB="${HOME}/.local/lib/agentic-workstation/install-agent-toolkit.sh"
_AT_FALLBACK="{{ .chezmoi.sourceDir }}/home/dot_local/lib/agentic-workstation/install-agent-toolkit.sh"
if [ ! -f "$_AT_LIB" ]; then
	if [ -f "$_AT_FALLBACK" ]; then
		warn "using fallback lib ${_AT_FALLBACK} (deployed copy not yet materialized)"
		_AT_LIB="$_AT_FALLBACK"
	else
		warn "missing ${_AT_LIB} — re-run chezmoi apply after pulling latest source"
		exit 1
	fi
fi

# shellcheck source=/dev/null
. "$_AT_LIB"

log "Installing agent-toolkit (canonical V CLI, thin workstation)..."
install_and_deploy_agent_toolkit
