#!/usr/bin/env bash
# chezmoi:template:left-delimiter="{{" right-delimiter="}}"
# Thin workstation — delegates all skills/packs/personas/agents/MCPs/loops
# to agent-toolkit via uv.
set -euo pipefail

log() { printf '\033[1;34m[agent-toolkit]\033[0m %s\n' "$*"; }
ok() { printf '\033[1;32m[agent-toolkit]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[agent-toolkit]\033[0m %s\n' "$*"; }
has_cmd() { command -v "$1" >/dev/null 2>&1; }

# Skip in CI/hermetic environments (chezmoi apply during testing)
if [ "${CI:-}" = "true" ] || [ -n "${HERMETIC_PORT:-}" ] || [ -n "${GITHUB_ACTIONS:-}" ]; then
	log "CI environment detected — skipping agent-toolkit install"
	exit 0
fi

log "Installing agent-toolkit (thin workstation)..."

if ! has_cmd uv; then
	warn "uv not found — install uv first: curl -LsSf https://astral.sh/uv/install.sh | sh"
	warn "Then re-run: chezmoi apply"
	exit 1
fi

log "Running: uv tool install --force agent-toolkit-cli"
if ! uv tool install --force agent-toolkit-cli; then
	warn "uv tool install --force agent-toolkit-cli failed"
	exit 1
fi

# Ensure ~/.local/bin is on PATH for this session so agent-toolkit is found
if ! has_cmd agent-toolkit; then
	export PATH="$HOME/.local/bin:$PATH"
fi

if has_cmd agent-toolkit; then
	log "Deploying profiles via: agent-toolkit install"
	if agent-toolkit install; then
		ok "agent-toolkit installed and profiles deployed (thin workstation)"
	else
		warn "agent-toolkit install failed — run 'agent-toolkit install' after restarting shell"
		exit 1
	fi
else
	warn "agent-toolkit not in PATH yet — restart your shell, then run: agent-toolkit install"
	warn "Or ensure ~/.local/bin is in PATH before running chezmoi apply again"
	exit 1
fi
