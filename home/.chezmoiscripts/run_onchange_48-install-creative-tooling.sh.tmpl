#!/usr/bin/env bash
# Creative tooling — installed only when the creative group is enabled.
# Provisions system creative applications for Agent Toolkit Creative
# Studio (skills/MCP definitions stay in agent-toolkit; this script only
# makes the applications available). Idempotent; never rewrites existing
# OBS/REAPER/audio configuration and never enables recording of any kind.
{{- $gCreative := index . "install_group_creative" | default false -}}
{{- if $gCreative }}
set -eo pipefail

if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  c_reset=$'\033[0m'
  c_blue=$'\033[1;34m'
  c_yellow=$'\033[1;33m'
  c_green=$'\033[1;32m'
else
  c_reset=''
  c_blue=''
  c_yellow=''
  c_green=''
fi

log() { printf '%b[creative-tooling]%b %s\n' "$c_blue" "$c_reset" "$*"; }
warn() { printf '%b[creative-tooling]%b %s\n' "$c_yellow" "$c_reset" "$*"; }
ok() { printf '%b[creative-tooling]%b %s\n' "$c_green" "$c_reset" "$*"; }
has_cmd() { command -v "$1" >/dev/null 2>&1; }

# translate_pkg maps a canonical package name to the distro package.
# Prints an empty string when there is no safe mapping (caller warns).
translate_pkg() {
  local pkg="$1"
  if has_cmd pacman; then
    echo "$pkg"
  elif has_cmd apt-get; then
    case "$pkg" in
      mlt) echo "melt" ;;
      *) echo "$pkg" ;;
    esac
  elif has_cmd dnf; then
    case "$pkg" in
      mlt) echo "mlt" ;;
      *) echo "$pkg" ;;
    esac
  elif has_cmd brew; then
    case "$pkg" in
      ffmpeg | blender) echo "$pkg" ;;
      *) echo "" ;;
    esac
  else
    echo ""
  fi
}

install_pkg() {
  local pkg="$1" bin="$2" real
  if has_cmd "$bin"; then
    ok "already installed: $bin"
    return 0
  fi
  # Fedora's mlt package ships the renderer as melt-7 in some releases.
  if [[ $bin == melt ]] && has_cmd melt-7; then
    ok "already installed: melt-7"
    return 0
  fi
  real="$(translate_pkg "$pkg")"
  if [[ -z $real ]]; then
    warn "no package mapping for $pkg on this system — install it manually if you need it"
    return 0
  fi
  log "installing $real"
  if has_cmd pacman; then
    sudo pacman -S --noconfirm --needed "$real"
  elif has_cmd apt-get; then
    sudo apt-get update -y && sudo apt-get install -y "$real"
  elif has_cmd dnf; then
    # Failures must propagate: this is a run_onchange script, so exiting 0
    # after a failed install would record the step as done and chezmoi
    # would never retry it. (ffmpeg/kdenlive on Fedora may need RPM Fusion.)
    sudo dnf install -y "$real"
  elif has_cmd brew; then
    brew install "$real"
  fi
}

{{- range .package_groups.creative }}
{{- if eq . "ffmpeg" }}
install_pkg ffmpeg ffmpeg
{{- else if eq . "mlt" }}
install_pkg mlt melt
{{- else if eq . "kdenlive" }}
install_pkg kdenlive kdenlive
{{- else if eq . "blender" }}
install_pkg blender blender
{{- end }}
{{- end }}

# Kdenlive MCP server for agent clients (PyPI name: mcp-kdenlive).
# Installed as an isolated pipx app; skipped when pipx is absent so this
# script never reaches for sudo pip. Capability install/enablement stays
# with agent-toolkit — this only provides the executable.
# Pinned to the reviewed release verified end-to-end by Agent Toolkit
# (mcp/registry/kdenlive.yaml records the evaluated upstream revision;
# 0.3.0 is the reviewed PyPI release of that line). Bump deliberately,
# never float on latest.
KDENLIVE_MCP_VERSION="0.3.0"
if has_cmd kdenlive-mcp; then
  installed_version="$(kdenlive-mcp --version 2>/dev/null || true)"
  if [[ $installed_version == *"$KDENLIVE_MCP_VERSION"* ]]; then
    ok "already installed: $installed_version"
  else
    warn "kdenlive-mcp present but not the pinned $KDENLIVE_MCP_VERSION (found: ${installed_version:-unknown}) — left as-is; align with: pipx install --force mcp-kdenlive==$KDENLIVE_MCP_VERSION"
  fi
elif has_cmd pipx; then
  log "installing mcp-kdenlive==$KDENLIVE_MCP_VERSION via pipx"
  pipx install "mcp-kdenlive==$KDENLIVE_MCP_VERSION" || warn "pipx install mcp-kdenlive failed — run it manually to see why"
else
  warn "pipx not found — skipping kdenlive-mcp (enable the python group, then: pipx install mcp-kdenlive==$KDENLIVE_MCP_VERSION)"
fi

if has_cmd kdenlive-mcp; then
  log "diagnosing creative toolchain (kdenlive-mcp diagnose)"
  kdenlive-mcp diagnose || warn "kdenlive-mcp diagnose reported missing pieces — run dots-creative-doctor for details"
fi

ok "creative tooling step complete (run: dots-creative-doctor)"
{{ end -}}
