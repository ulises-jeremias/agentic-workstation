# chezmoi:template:left-delimiter="{{" right-delimiter="}}"
#
# Skills are distributed by agent-toolkit. This file intentionally contains no
# Jira or Confluence archives; those capabilities are bundled in the Toolkit.
# Entries are relative to ~/.local/share/agentic-workstation/
#
# Chezmoi handles download, extraction, caching, and refresh automatically.
# After chezmoi apply, run `dots-skills sync` to create AI tool symlinks.
#
# To refresh cached archives: chezmoi apply --refresh-externals
#
# ── agentic-workstation Slack Assistant Skills (placeholder) ────────────────────────────────
# Enabled automatically when the "productivity" group is selected at
# chezmoi init. Uncomment once the repo is published. Until then the
# install_skill_dots_ai_slack_assistant flag is rendered but has no effect.
# {{- if (index . "install_skill_dots_ai_slack_assistant" | default false) }}
# ["skills-external/dots-slack-assistant"]
#     type            = "archive"
#     url             = "https://github.com/ulises-jeremias/dots-slack-Assistant-Skills/archive/refs/heads/main.tar.gz"
#     stripComponents = 2
#     include         = ["*/skills/**"]
#     refreshPeriod   = "168h"
# {{- end }}

# ── Template: single skill from GitHub ───────────────────────────────────────
# A single-skill repo: key = "skills-external/<name>", stripComponents=1
# {{- if (index . "install_skill_my_skill" | default false) }}
# ["skills-external/my-skill"]
#     type            = "archive"
#     url             = "https://github.com/org/my-skill/archive/refs/heads/main.tar.gz"
#     stripComponents = 1
#     refreshPeriod   = "168h"
# {{- end }}

# ── Template: skill pack from GitHub ─────────────────────────────────────────
# A multi-skill repo: key = "skills-external/<pack-name>", stripComponents=2
# dots-skills sync will discover each subdir with SKILL.md inside the pack dir.
# {{- if (index . "install_skill_my_pack" | default false) }}
# ["skills-external/my-pack"]
#     type            = "archive"
#     url             = "https://github.com/org/my-pack/archive/refs/heads/main.tar.gz"
#     stripComponents = 2
#     include         = ["*/skills/**"]
#     refreshPeriod   = "168h"
# {{- end }}
