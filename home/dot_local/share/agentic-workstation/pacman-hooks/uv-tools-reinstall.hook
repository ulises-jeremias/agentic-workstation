[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = python

[Action]
Description = Upgrading uv-managed tools after Python upgrade...
When = PostTransaction
Exec = /usr/bin/env bash -c 'for u in $(getent passwd | awk -F: '\''$3 >= 1000 && $7 !~ /(nologin|false)$/ {print $1}'\''); do h=$(getent passwd "$u" | cut -d: -f6); uv_bin="$h/.local/bin/uv"; if [ ! -x "$uv_bin" ]; then uv_bin=$(command -v uv 2>/dev/null); fi; if [ -x "$uv_bin" ] && [ -d "$h/.local/share/uv/tools" ]; then if ! runuser -u "$u" -- env HOME="$h" PATH="$h/.local/bin:/usr/local/bin:/usr/bin:/bin" "$uv_bin" tool upgrade --all; then logger -t uv-tools-reinstall "uv tool upgrade --all failed for user $u; review pacman output and repair tools with uv tool install --force"; fi; fi; done'
