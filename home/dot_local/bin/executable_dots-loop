#!/usr/bin/env bash
# dots-loop — wrapper around agent-toolkit loop CLI.
#
# agent-toolkit loop is the canonical loop engineering runtime.
# Install: uvx agent-toolkit-cli  or  pip install agent-toolkit-cli
#
# Usage:
#   dots-loop <subcommand> [args...]
#   dots-loop init oss-daily-briefing
#   dots-loop run oss-pr-monitor
#   dots-loop status
#   dots-loop audit
#   dots-loop cost oss-pr-monitor
#   dots-loop sync
#   dots-loop help

set -euo pipefail

if ! command -v agent-toolkit &>/dev/null; then
  printf '\033[1;31m[dots-loop] error:\033[0m agent-toolkit not found.\n' >&2
  echo "" >&2
  echo "Install it:" >&2
  echo "  uvx agent-toolkit-cli            # one-shot, no install" >&2
  echo "  pip install agent-toolkit-cli    # permanent install" >&2
  exit 1
fi

exec agent-toolkit loop "$@"
